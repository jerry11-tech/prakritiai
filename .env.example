# 🌿 Prakriti AI Production Environment Configuration Example

# FastAPI Backend Configuration
PRAKRITIAI_JWT_SECRET=your-secure-random-256bit-jwt-secret-here
PRAKRITIAI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Database & Storage
SQLITE_DB_PATH=src/backend/db/prakriti.db
UPLOAD_DIR=src/backend/uploads

# Server Port
PORT=8000
